{
  "info": {"name": "HustleHub+ API Security Tests", "description": "Non-mutating automated API security and validation checks. Intended for local HTTPS development server.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl","value":"https://localhost:5000"}],
  "item": [
    {"name":"Authentication", "item":[
      {"name":"GET profile without token returns 401", "request":{"method":"GET","url":"{{baseUrl}}/api/auth/me"}, "event":[{"listen":"test","script":{"exec":["pm.test('Status 401', () => pm.response.to.have.status(401));","pm.test('JSON response', () => pm.response.to.be.json);","pm.test('Bearer token required', () => pm.expect(pm.response.json().message).to.eql('Bearer token required'));","pm.test('Security header present', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));"],"type":"text/javascript"}}]},
      {"name":"GET profile with invalid token returns 401", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer invalid.jwt.token"}],"url":"{{baseUrl}}/api/auth/me"}, "event":[{"listen":"test","script":{"exec":["pm.test('Status 401', () => pm.response.to.have.status(401));","pm.test('JSON response', () => pm.response.to.be.json);"],"type":"text/javascript"}}]}
    ]},
    {"name":"Registration and Login Validation", "item":[
      {"name":"Registration rejects invalid email", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Test Person\",\"email\":\"not-an-email\",\"password\":\"Password123\",\"role\":\"Client\"}"},"url":"{{baseUrl}}/api/auth/register"}, "event":[{"listen":"test","script":{"exec":["pm.test('Status 400', () => pm.response.to.have.status(400));","pm.test('Validation errors returned', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"],"type":"text/javascript"}}]},
      {"name":"Registration rejects short password", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Test Person\",\"email\":\"valid@example.com\",\"password\":\"short\",\"role\":\"Client\"}"},"url":"{{baseUrl}}/api/auth/register"}, "event":[{"listen":"test","script":{"exec":["pm.test('Status 400', () => pm.response.to.have.status(400));","pm.test('Validation errors returned', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"],"type":"text/javascript"}}]},
      {"name":"Registration rejects invalid role", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Test Person\",\"email\":\"valid@example.com\",\"password\":\"Password123\",\"role\":\"Admin\"}"},"url":"{{baseUrl}}/api/auth/register"}, "event":[{"listen":"test","script":{"exec":["pm.test('Status 400', () => pm.response.to.have.status(400));","pm.test('Validation errors returned', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"],"type":"text/javascript"}}]},
      {"name":"Login rejects invalid email", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"invalid-email\",\"password\":\"Password123\"}"},"url":"{{baseUrl}}/api/auth/login"}, "event":[{"listen":"test","script":{"exec":["pm.test('Status 400', () => pm.response.to.have.status(400));","pm.test('Validation errors returned', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"],"type":"text/javascript"}}]},
      {"name":"Login rejects empty password", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"valid@example.com\",\"password\":\"\"}"},"url":"{{baseUrl}}/api/auth/login"}, "event":[{"listen":"test","script":{"exec":["pm.test('Status 400', () => pm.response.to.have.status(400));","pm.test('Validation errors returned', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"],"type":"text/javascript"}}]}
    ]},
    {"name":"Protected Marketplace Endpoints", "item":[
      {"name":"POST gig without token returns 401", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"Test Service\",\"description\":\"Test description\",\"category\":\"Web Development\",\"price\":500}"},"url":"{{baseUrl}}/api/gigs"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 401', () => pm.response.to.have.status(401));"],"type":"text/javascript"}}]},
      {"name":"GET bookings without token returns 401", "request":{"method":"GET","url":"{{baseUrl}}/api/bookings/mine"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 401', () => pm.response.to.have.status(401));"],"type":"text/javascript"}}]},
      {"name":"POST booking without token returns 401", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"gigId\":\"000000000000000000000001\"}"},"url":"{{baseUrl}}/api/bookings"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 401', () => pm.response.to.have.status(401));"],"type":"text/javascript"}}]},
      {"name":"GET transactions without token returns 401", "request":{"method":"GET","url":"{{baseUrl}}/api/transactions/mine"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 401', () => pm.response.to.have.status(401));"],"type":"text/javascript"}}]},
      {"name":"GET earnings without token returns 401", "request":{"method":"GET","url":"{{baseUrl}}/api/transactions/earnings"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 401', () => pm.response.to.have.status(401));"],"type":"text/javascript"}}]},
      {"name":"POST payment without token returns 401", "request":{"method":"POST","url":"{{baseUrl}}/api/transactions/pay/000000000000000000000001"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 401', () => pm.response.to.have.status(401));"],"type":"text/javascript"}}]}
    ]}
  ]
}
